# Copy this file to .env and fill in your keys.
# Lines starting with # are comments.

# --- Adzuna (free tier: 250 req/day, salary data, 12 countries) ---
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- RapidAPI / JSearch (free tier: 200 req/month; paid plans for higher volume) ---
# Register at https://rapidapi.com/ and subscribe to the JSearch API
RAPIDAPI_KEY=

# --- Scrapers to run (comma-separated) ---
# jobspy and remotive need no API keys; adzuna and jsearch need keys above
# Add "jsearch" to use the RapidAPI/JSearch paid fallback scraper
ENABLED_SCRAPERS=jobspy,remotive,adzuna
# ENABLED_SCRAPERS=jobspy,remotive,adzuna,jsearch

# --- JobSpy sites (comma-separated) ---
JOBSPY_SITES=linkedin,indeed,glassdoor,zip_recruiter

# --- Matching mode: semantic (default) or keyword ---
MATCHING_MODE=semantic

# --- Anthropic / Claude (optional — pipeline works without this key) ---
# Register at: https://console.anthropic.com/
# All Claude features (smart parsing, query gen, re-ranking) activate when set.
# Use --no-claude flag to disable for a specific run.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_RERANK_TOP_N=25
CLAUDE_BATCH_SIZE=10
